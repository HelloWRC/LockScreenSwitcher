<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}"
      Language="zh-CN"
      TabFocusNavigation="Cycle"
      Padding="0,16">
    <Grid.Resources>
        <DataTemplate x:Key="ProviderRow">
            <Grid Height="52" ColumnSpacing="12" Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="Logo" Width="32" Height="32" Stretch="Uniform"
                       AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AppName" FontSize="14" LineHeight="20"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock x:Name="AppId" FontSize="12" LineHeight="16"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="16,0,16,8" Spacing="4">
        <TextBlock Text="选择锁屏应用" FontSize="20" FontWeight="Bold" LineHeight="26"
                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="选择的应用将被用作当前用户的锁屏实现。" FontSize="13" LineHeight="17"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
    </StackPanel>
    <ListView x:Name="Providers" Grid.Row="1" SelectionMode="Single" Padding="0,4,2,0"
              SingleSelectionFollowsFocus="False"
              ScrollViewer.HorizontalScrollMode="Disabled"
              AutomationProperties.Name="锁屏应用">
        <ListView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                                         Color="{ThemeResource SystemListLowColor}" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                                         Color="{ThemeResource SystemListMediumColor}" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                                         Color="{ThemeResource SystemListMediumColor}" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                                         Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                                         Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                                         Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </ListView.Resources>
    </ListView>
    <StackPanel Grid.Row="2">
        <Border Height="1" Margin="8,17,0,17"
                Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
        <TextBlock Margin="16,0" FontSize="14" LineHeight="16" MinHeight="32"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                   Text="确认后将重启文件资源管理器（Explorer），当前打开的文件窗口状态将可能丢失。" />
        <ScrollViewer x:Name="ErrorPanel" Visibility="Collapsed" Margin="16,10,16,0" MaxHeight="64"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <TextBlock x:Name="ErrorText" FontSize="14" LineHeight="16" MinHeight="32"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                       AutomationProperties.LiveSetting="Assertive" />
        </ScrollViewer>
        <Grid Margin="16,14,16,0" Height="32">
            <ProgressRing x:Name="Progress" Width="20" Height="20" HorizontalAlignment="Left"
                          Visibility="Collapsed" AutomationProperties.Name="正在切换锁屏应用" />
            <FontIcon x:Name="Success" Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                      HorizontalAlignment="Left" Visibility="Collapsed"
                      Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                      AutomationProperties.Name="锁屏应用已切换" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="Confirm" Content="确认" Width="120" Height="32"
                    HorizontalAlignment="Right" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </StackPanel>
</Grid>
